# FFmpeg Worker Environment Variables
# Copy to .env and customize as needed

# HTTP port (cloud platforms inject their own PORT — do not hardcode in production)
PORT=7860

# API key for authentication (empty = no auth)
# If set, n8n must send X-API-Key header with this value
API_KEY=""

# Directory for temporary file storage
STORAGE_DIR=/tmp/ffmpeg-worker

# How long to keep output files (hours)
FILE_RETENTION_HOURS=24

# How often to run cleanup (seconds)
CLEANUP_INTERVAL_SECONDS=3600

# Max FFmpeg job duration (seconds)
MAX_JOB_TIMEOUT_SECONDS=1800

# Max upload/download file size (MB)
MAX_FILE_SIZE_MB=500

# Max yt-dlp download timeout (seconds)
MAX_DOWNLOAD_TIMEOUT_SECONDS=300
